#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        sticky_behavior: sticky_behavior {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_BEHAVIOR";
            bindings = <&mmv>;
            #binding-cells = <1>;
            release-after-ms = <0>;
        };

        volume_encoder: volume_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            label = "VOLUME_ENCODER";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOLUME_UP>, <&kp C_VOLUME_DOWN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Base";

            /*
             * 42 ปุ่ม:
             * 3 แถว × 6 ปุ่มต่อฝั่ง
             * + 3 ปุ่มนิ้วโป้งต่อฝั่ง
             */

            bindings = <
&kp TAB    &kp Q  &kp W  &kp E     &kp R  &kp T        &kp Y      &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LSHFT  &kp A  &kp S  &kp D     &kp F  &kp G        &kp H      &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z  &kp X  &kp C     &kp V  &kp B        &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp DELETE
                         &kp LALT  &mo 1  &kp SPACE    &kp ENTER  &mo 2  &kp LGUI
            >;

            /*
             * Sensor ตัวที่ 1 = knob ซ้าย
             * หมุนตามเข็มเพิ่มเสียง / ทวนเข็มลดเสียง
             *
             * Sensor ตัวที่ 2 = encoder หรือ slider ทางขวา
             * ตอนนี้ตั้งเป็นเลื่อนหน้าขึ้น/ลงก่อน
             */

            sensor-bindings = <
                &inc_dec_kp C_VOL_UP C_VOL_DN
                &inc_dec_kp PG_UP    PG_DN
            >;
        };

        number_layer {
            label = "number";
            bindings = <
&kp TAB    &kp N1  &kp N2  &kp N3    &kp N4  &kp N5       &kp N6     &kp N7  &kp N8     &kp N9   &kp N0    &kp BSPC
&kp LSHFT  &kp A   &kp S   &kp D     &kp F   &kp G        &kp H      &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL  &kp Z   &kp X   &kp C     &kp V   &kp B        &kp N      &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp DELETE
                           &kp LALT  &trans  &kp SPACE    &kp ENTER  &trans  &kp LGUI
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp PG_UP PG_DN>;
        };

        tools_layer {
            bindings = <
&kp ESC    &kp GRAVE  &kp F1  &kp F2    &kp F3   &kp F4       &kp HOME   &kp END         &trans     &kp MINUS  &kp EQUAL  &kp BSPC
&kp LSHFT  &trans     &kp F5  &kp F6    &kp F7   &kp F8       &trans     &kp UP_ARROW    &trans     &kp LBKT   &kp RBKT   &kp BSLH
&kp LCTRL  &trans     &kp F9  &kp F10   &kp F11  &kp F12      &kp LEFT   &kp DOWN_ARROW  &kp RIGHT  &trans     &trans     &trans
                              &kp LALT  &trans   &kp SPACE    &kp ENTER  &trans          &kp CAPS
            >;

            label = "tools";
        };

        setting_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;

            label = "setting";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        to_setiings {
            if-layers = <0>;
            then-layer = <3>;
        };
    };
};
